// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "thought_level": "low",
        "model": "openai-codex/gpt-5.6-sol"
      },
      "type": "registry"
    },
    "amp-acp": {
      "default_config_options": {
        "effort": "xhigh"
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Catppuccin Macchiato"
  },
  "ssh_connections": [
    {
      "host": "x4132-prod0",
      "args": [],
      "projects": [
        {
          "paths": [
            "/etc/nixos"
          ]
        },
        {
          "paths": [
            "/home/msvc/.clawdbot"
          ]
        }
      ]
    },
    {
      "host": "janknuc",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/msvc"
          ]
        },
        {
          "paths": [
            "/home/msvc/attachments"
          ]
        },
        {
          "paths": [
            "/home/msvc/handout/./"
          ]
        }
      ]
    },
    {
      "host": "orb",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/msvc/syrup"
          ]
        }
      ]
    },
    {
      "host": "bigger-data",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/johndoe/x-event-reassembler"
          ]
        }
      ]
    }
  ],
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "profiles": {
      "vibe": {
        "name": "vibe",
        "tools": {
          "thinking": true,
          "terminal": true,
          "read_file": true,
          "project_notifications": true,
          "open": true,
          "now": true,
          "move_path": true,
          "grep": true,
          "list_directory": true,
          "find_path": true,
          "fetch": true,
          "edit_file": true,
          "diagnostics": true,
          "create_directory": true,
          "delete_path": true,
          "copy_path": true,
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-server-shopify-dev": {
            "tools": {
              "get_started": true,
              "introspect_admin_schema": true,
              "search_dev_docs": true,
              "fetch_docs_by_path": true,
            },
          },
          "mcp-server-context7": {
            "tools": {
              "resolve-library-id": true,
              "get-library-docs": true,
            },
          },
        },
      },
    },
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",
    },
    "default_profile": "write",
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "x-ai/grok-4.5",
    },
  },
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "fixed",
  },
  "always_treat_brackets_as_autoclosed": true,
  // LSP on-type formatting can insert stray indents while typing ")" etc.
  // (e.g. https://github.com/biomejs/biome-zed/issues/164)
  "use_on_type_format": false,
  "format_on_save": "off",
  "formatter": "auto",
  "git": {
    "git_gutter": "tracked_files",
    "gutter_debounce": 2000,
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true,
      "delay_ms": 5000,
    },
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": false,
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cn"],
      },
    },
  },
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
      ],
    },
  },
  "ensure_final_newline_on_save": false,
}
