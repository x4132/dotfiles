// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "markdown_preview_font_size": 20.0,
  "markdown_preview_code_font_family": ".ZedMono",
  "markdown_preview_font_family": ".ZedSans",
  "terminal": {
    "font_size": 18.0,
  },
  "diff_view_style": "split",
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "thought_level": "low",
        "model": "openai-codex/gpt-5.6-sol",
      },
      "type": "registry",
    },
    "amp-acp": {
      "default_config_options": {
        "amp-mode": "high",
      },
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Catppuccin Macchiato",
  },
  "vim_mode": true,
  "ui_font_size": 22.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "agent": {
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "profiles": {},
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4-flash",
    },
    "default_profile": "write",
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "x-ai/grok-4.5",
    },
  },
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "fixed",
  },
  "always_treat_brackets_as_autoclosed": true,
  "format_on_save": "off",
  "formatter": "auto",
  "git": {
    "git_gutter": "tracked_files",
    "gutter_debounce": 2000,
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true,
      "delay_ms": 5000,
    },
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": false,
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cn"],
      },
    },
  },
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
      ],
    },
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
      "**/helmfile.d/**/*.yaml",
      "**/helmfile.d/**/*.yml",
      "**/values*.yaml",
    ],
  },
  "ensure_final_newline_on_save": false,
}
